# Local env template (copy to .env.local — never commit the real file).
# Server-side only: loaded by src/env.ts. No browser key, no client exposure.

# Jev (TypeSafe) — server-side only. Empty = Jev disabled with safe fallback.
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# OpenAI (LLM jobs) — server-side only, never exposed to the browser.
# Empty = rubric/explain degrade to safe fallbacks (no throws for content).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_TIMEOUT_MS=15000
# OPENAI_MAX_RETRIES=2

# GiveCampus overrides (optional)
# GIVE_CAMPUS_DATA_DIR=
# GIVE_CAMPUS_SCHEMA=
# GIVE_CAMPUS_DB=
# PORT=3000
