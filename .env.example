# Required by both demo runtimes. Copy this file to `.env` for the Python
# façade or `.env.local` for the TypeScript advancement backend.
OPENAI_API_KEY=
TYPESAFE_API_KEY=

# Shared optional model/provider settings
# OPENAI_EMBED_KEY=              # separate account for bulk embedding
# OPENCODE_API_KEY=              # additional benchmark arms
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Python Ball Knowledge façade
# BK_LLM_MODEL=gpt-5.6-luna
# BK_EXPLAIN_MODEL=gpt-5.4-mini
# BK_JUDGE_MODEL=gpt-5.2
# BK_RETRIEVAL_WEIGHT=0.4
# BK_LLM_PRICE_IN=0.20
# BK_LLM_PRICE_OUT=1.20

# TypeScript GiveCampus backend
# OPENAI_MODEL=gpt-5-mini
# OPENAI_TIMEOUT_MS=60000
# OPENAI_MAX_RETRIES=2
# GIVE_CAMPUS_DATA_DIR=
# GIVE_CAMPUS_SCHEMA=
# GIVE_CAMPUS_DB=
# PORT=3000
