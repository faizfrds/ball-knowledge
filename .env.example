# Jev / TypeSafe (https://typesafe.ai) - powers the gate and per-criterion checks
TYPESAFE_API_KEY=
# Jev pricing: $0.042 per million input tokens, output tokens are free.
TYPESAFE_INPUT_PRICE_PER_MTOK=0.042

# OpenAI (https://platform.openai.com) - powers the single structured-extraction
# call, the top-10 explanations, the design-query parser, and the LLM-only baseline
OPENAI_API_KEY=

