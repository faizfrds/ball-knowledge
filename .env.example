# Required
OPENAI_API_KEY=sk-...
TYPESAFE_API_KEY=apikey_...

# Optional
OPENAI_EMBED_KEY=sk-...          # separate account for bulk embedding (higher TPM)
OPENCODE_API_KEY=oc_sk_...       # extra benchmark arms via the OpenCode Zen gateway
BK_LLM_MODEL=gpt-5.2             # rubric compiler
BK_EXPLAIN_MODEL=gpt-5.4-mini    # result explanations
BK_JUDGE_MODEL=gpt-5.2           # relevance judging in comparisons
BK_RETRIEVAL_WEIGHT=0.4          # blend of retrieval rank into the final score
BK_LLM_PRICE_IN=1.75             # $/1M input tokens, for the cost receipt
BK_LLM_PRICE_OUT=14.00           # $/1M output tokens
