{
  "name": "ball-knowledge",
  "version": "0.1.0",
  "private": true,
  "description": "GiveCampus Ball Knowledge prototype — application/data foundation (ingestion + SQLite access + as-of-safe features). No ranking/UI yet.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm run ingest",
    "ingest": "tsx src/scripts/ingest.ts",
    "dev": "tsx watch src/server.ts",
    "demo": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "benchmark:complex:offline": "tsx src/scripts/benchmark-complex-offline.ts",
    "benchmark:complex:cache": "tsx src/scripts/cache-complex-benchmark-embeddings.ts",
    "benchmark:complex:live": "tsx src/scripts/benchmark-complex-live.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
